# Firebase (cliente web) — ver FIREBASE_SETUP.md
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# false = Firebase nube (recomendado celular) | true = emuladores locales
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# EmailJS — envío automático gratis de comprobantes (alternativa a Blaze + Resend)
# También configurable en Ajustes → Notificaciones
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_REPLY_TO=
