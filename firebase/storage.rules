rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    match /organizations/{organizationId}/{allPaths=**} {
      allow read: if isOrgMember(organizationId);
      allow write: if isOrgMember(organizationId)
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
