rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userMembershipCount() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.memberships.size()
        : 0;
    }

    function hasActiveMembershipInProfile(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userMembershipCount() > 0
        && userDoc().data.memberships[0].organizationId == orgId
        && userDoc().data.memberships[0].isActive == true;
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function canAccessOrg(orgId) {
      return isOrgMember(orgId) || hasActiveMembershipInProfile(orgId);
    }

    function guestTokenMatchesTable(orgId, tableId, token) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/diningTables/$(tableId)).data.qrToken == token;
    }

    function validGuestSessionCreate(orgId) {
      return request.resource.data.organizationId == orgId
        && request.resource.data.status == 'open'
        && request.resource.data.guestToken is string
        && request.resource.data.tableId is string
        && guestTokenMatchesTable(orgId, request.resource.data.tableId, request.resource.data.guestToken);
    }

    function validGuestSessionUpdate(orgId) {
      return resource.data.organizationId == orgId
        && request.resource.data.guestToken == resource.data.guestToken
        && request.resource.data.tableId == resource.data.tableId
        && guestTokenMatchesTable(orgId, resource.data.tableId, resource.data.guestToken)
        && (
          (resource.data.status == 'open' && request.resource.data.status == 'open')
          || (resource.data.status == 'open' && request.resource.data.status == 'requested_bill')
          || (
            request.resource.data.status == resource.data.status
            && (resource.data.status == 'open' || resource.data.status == 'requested_bill')
            && request.resource.data.waiterRequestedAt is string
            && request.resource.data.waiterRequestedAt.size() > 0
          )
        );
    }

    function isOrgOwner(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.roles.hasAny(['owner']);
    }

    match /organizationSlugs/{slug} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && userMembershipCount() == 0
        && request.resource.data.organizationId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.memberships.size() == 1
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && resource.data.memberships.size() == 0
        && request.resource.data.memberships.size() == 1;
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if canAccessOrg(organizationId);
      allow create: if isSignedIn()
        && userMembershipCount() == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status == 'trial'
        && request.resource.data.name is string
        && request.resource.data.slug is string;
      allow update: if canAccessOrg(organizationId)
        && request.resource.data.name == resource.data.name
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.status == resource.data.status
        && request.resource.data.settings == resource.data.settings
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isSignedIn() && request.auth.uid == memberId;
        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.organizationId == organizationId
          && request.resource.data.roles.size() == 1
          && request.resource.data.roles[0] == 'owner'
          && request.resource.data.isActive == true
          && (
            userMembershipCount() == 0
            || hasActiveMembershipInProfile(organizationId)
          );
        allow update, delete: if false;
      }

      match /branches/{branchId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if isSignedIn()
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid
          && (isOrgOwner(organizationId) || userMembershipCount() == 0);
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if canAccessOrg(organizationId);
        allow create, update, delete: if false;
      }

      match /inventoryItems/{itemId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /warehouses/{warehouseId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /inventoryMovements/{movementId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.actorUserId == request.auth.uid;
        allow update, delete: if false;
      }

      match /inventoryBalances/{balanceId} {
        allow read: if canAccessOrg(organizationId);
        allow create, update: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /inventoryLots/{lotId} {
        allow read: if canAccessOrg(organizationId);
        allow create, update: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /analyticsDaily/{dateId} {
        allow read: if canAccessOrg(organizationId);
        allow create, update: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.date is string;
        allow delete: if false;
      }

      match /menuProducts/{productId} {
        allow read: if canAccessOrg(organizationId)
          || resource.data.status == 'active';
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.price >= 0
          && (
            !('imageDataUrl' in request.resource.data)
            || request.resource.data.imageDataUrl.size() <= 500000
          );
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId
          && (
            !('imageDataUrl' in request.resource.data)
            || request.resource.data.imageDataUrl.size() <= 500000
          );
        allow delete: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
      }

      match /sales/{saleId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.cashierUserId == request.auth.uid
          && request.resource.data.status == 'paid';
        allow update, delete: if false;
      }

      match /kitchenOrders/{orderId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /brandAssets/{assetId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 500000;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /recipes/{recipeId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
        allow delete: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;

        match /versions/{versionId} {
          allow read: if canAccessOrg(organizationId);
          allow create: if canAccessOrg(organizationId)
            && request.resource.data.organizationId == organizationId
            && request.resource.data.createdBy == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /purchaseInvoices/{invoiceId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'draft';
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId
          && resource.data.status == 'draft';
        allow delete: if false;
      }

      match /suppliers/{supplierId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.isActive == true;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /purchasePriceHistory/{entryId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /fixedExpenses/{expenseId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount > 0
          && request.resource.data.monthlyEquivalent > 0;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /diningTables/{tableId} {
        allow read: if canAccessOrg(organizationId)
          || resource.data.status != 'closed';
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.qrToken is string;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /tableQrLookup/{qrToken} {
        allow read: if resource.data.status != 'closed';
        allow create, update: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.qrToken == qrToken;
        allow delete: if canAccessOrg(organizationId);
      }

      match /tableSessions/{sessionId} {
        allow read: if canAccessOrg(organizationId)
          || (resource.data.guestToken is string
            && (resource.data.status == 'open' || resource.data.status == 'requested_bill'));
        allow create: if (canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid)
          || validGuestSessionCreate(organizationId);
        allow update: if (canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId)
          || validGuestSessionUpdate(organizationId);
        allow delete: if false;
      }

      match /cashSessions/{sessionId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.status == 'open'
          && request.resource.data.openedBy == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.openingAmount >= 0;
        allow update: if canAccessOrg(organizationId)
          && resource.data.organizationId == organizationId
          && resource.data.status == 'open'
          && request.resource.data.status == 'closed'
          && request.resource.data.closedBy == request.auth.uid;
        allow delete: if false;
      }

      match /cashMovements/{movementId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.actorUserId == request.auth.uid
          && request.resource.data.amount > 0
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 2;
        allow update, delete: if false;
      }

      match /notificationOutbox/{entryId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId;
        allow update, delete: if false;
      }

      match /domainEventOutbox/{entryId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /workflowOutbox/{entryId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.status == 'pending';
        allow update: if canAccessOrg(organizationId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['ready', 'sent', 'failed', 'skipped'];
        allow delete: if false;
      }

      match /analyticsDaily/{dateId} {
        allow read: if canAccessOrg(organizationId);
        allow create, update, delete: if false;
      }

      match /notificationPreferences/{userId} {
        allow read: if canAccessOrg(organizationId);
        allow create, update: if canAccessOrg(organizationId)
          && request.auth.uid == userId
          && request.resource.data.organizationId == organizationId;
        allow delete: if false;
      }

      match /workShifts/{shiftId} {
        allow read: if canAccessOrg(organizationId);
        allow create, update: if canAccessOrg(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.createdBy == request.auth.uid;
        allow delete: if false;
      }

      match /agentKnowledge/{entryId} {
        allow read: if canAccessOrg(organizationId);
        allow create: if canAccessOrg(organizationId);
        allow update: if canAccessOrg(organizationId);
        allow delete: if false;
      }

      match /agentSessions/{sessionId} {
        allow read: if canAccessOrg(organizationId)
          && resource.data.userId == request.auth.uid;
        allow create, update: if canAccessOrg(organizationId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
