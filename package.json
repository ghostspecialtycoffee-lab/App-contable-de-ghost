{
  "name": "ghost-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Ghost ERP — sistema POS y contable para negocios gastronómicos",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "deploy:setup": "pnpm install && pnpm test && pnpm build",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:backend": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "firebase:deploy:hosting": "pnpm --filter @ghost/web build && firebase deploy --only hosting",
    "reset:org": "node scripts/reset-organization-data.mjs",
    "import:purchases": "node scripts/import-initial-purchases.mjs"
  },
  "devDependencies": {
    "firebase-tools": "13",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20"
  }
}
